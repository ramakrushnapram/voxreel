# ---- Secrets ----
# Pollo, ElevenLabs, and YouTube credentials live in user-secrets or environment
# variables. Nothing containing a real key may ever be committed.
appsettings.*.Local.json
appsettings.Local.json
secrets.json
*.pfx
*.p12
.env
.env.*
!.env.example

